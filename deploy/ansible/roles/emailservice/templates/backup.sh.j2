#!/bin/bash
# Offline backup. MAILHUB_BACKUP_DIR should be an encrypted off-host mount.
set -euo pipefail
umask 077
BACKUP_DIR="${MAILHUB_BACKUP_DIR:-{{ app_dir }}/backup}"
TIMESTAMP=$(date -u +%Y%m%dT%H%M%SZ)
ARCHIVE="${BACKUP_DIR}/mailhub-${TIMESTAMP}.tar.gz"
mkdir -p "$BACKUP_DIR"
WAS_ACTIVE=false
if systemctl is-active --quiet emailservice; then WAS_ACTIVE=true; fi
restart_service() { if "$WAS_ACTIVE"; then systemctl start emailservice; fi; }
trap restart_service EXIT
systemctl stop emailservice
mailhub-backup create --data-dir '{{ data_dir }}' --archive "$ARCHIVE"
mailhub-backup verify --archive "$ARCHIVE"
# Configuration and secrets are kept separately from the portable data archive.
tar -czf "${ARCHIVE}.config.tar.gz" -C '{{ app_dir }}' config.yaml docker-compose.yml .env
# External identity databases require their own consistent dump while stopped.
if [ "${MAILHUB_BACKUP_POSTGRES:-false}" = true ]; then
  docker exec mail-postgres pg_dump -U '{{ postgres_user }}' '{{ postgres_db }}' | gzip > "${ARCHIVE}.postgres.sql.gz"
fi
# Pruning is opt-in; only validated newer archives permit removal.
if [ "${MAILHUB_PRUNE_BACKUPS:-false}" = true ]; then
  find "$BACKUP_DIR" -maxdepth 1 -type f -name 'mailhub-*.tar.gz*' -mtime +30 -delete
fi
printf 'Verified backup: %s\n' "$ARCHIVE"
