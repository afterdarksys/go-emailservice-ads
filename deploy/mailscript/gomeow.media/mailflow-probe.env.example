# Copy to a root-readable environment file. Do not commit the real password.
MAILFLOW_SMTP_ADDR=mail.gomeow.media:25
MAILFLOW_IMAP_ADDR=mail.gomeow.media:993
MAILFLOW_SENDER=mailflow-probe@gomeow.media
MAILFLOW_RECIPIENT=mailflow-probe@gomeow.media
MAILFLOW_IMAP_USER=mailflow-probe
MAILFLOW_IMAP_PASSWORD=replace-with-a-dedicated-random-password
MAILFLOW_INTERVAL=5m
MAILFLOW_TIMEOUT=60s
MAILFLOW_LISTEN=127.0.0.1:9765
